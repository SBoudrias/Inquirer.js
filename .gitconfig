[hook "lint-staged"]
	event = pre-commit
	command = sh -c 'yarn nano-staged'

[hook "auto-install"]
	event = post-checkout
	# Tolerate environments without `yarn` on PATH (e.g. fresh CI or tool
	# managers like mise); the developer/agent installs deps when present.
	command = sh -c 'command -v yarn >/dev/null 2>&1 && yarn install || true'

[hook "full-test"]
	event = pre-push
	# Commitlint runs first, so a non-conventional subject fails fast
	# instead of after the full test suite (~1-2min). Guarded on the
	# origin/main..HEAD count because this hook fires on every push,
	# including no-op ones, where an empty range would make commitlint
	# exit 9 (--from equals --to).
	command = sh -c 'if [ "$(git rev-list --count origin/main..HEAD)" -gt 0 ]; then yarn commitlint --from origin/main --to HEAD; fi && CI=true yarn pretest && yarn test'
