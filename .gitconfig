[hook "lint-staged"]
	event = pre-commit
	command = sh -c 'yarn nano-staged'

[hook "auto-install"]
	event = post-checkout
	# Tolerate environments without `yarn` on PATH (e.g. fresh CI or tool
	# managers like mise); the developer/agent installs deps when present.
	command = sh -c 'command -v yarn >/dev/null 2>&1 && yarn install || true'

[hook "full-test"]
	event = pre-push
	# Commitlint runs first, so a non-conventional subject fails the push
	# in seconds instead of after the full test suite (~1-2min). The grep
	# skips it when the branch has no commits over origin/main — the hook
	# fires on every push, including no-op ones, and commitlint exits 9
	# when --from equals --to. Written without double quotes or semicolons:
	# git config strips the former and cuts the value at the latter. Needs
	# origin/main to exist locally (it does after any clone or fetch).
	command = sh -c 'git rev-list --count origin/main..HEAD | grep -q ^0$ || yarn commitlint --from origin/main --to HEAD && CI=true yarn pretest && yarn test'
