{
  "name": "@inquirer/root",
  "private": true,
  "keywords": [
    "answer",
    "answers",
    "ask",
    "base",
    "cli",
    "command",
    "command-line",
    "confirm",
    "enquirer",
    "generate",
    "generator",
    "hyper",
    "input",
    "inquire",
    "inquirer",
    "interface",
    "iterm",
    "javascript",
    "menu",
    "node",
    "nodejs",
    "prompt",
    "promptly",
    "prompts",
    "question",
    "readline",
    "scaffold",
    "scaffolder",
    "scaffolding",
    "stdin",
    "stdout",
    "terminal",
    "tty",
    "ui",
    "yeoman",
    "yo",
    "zsh"
  ],
  "license": "MIT",
  "author": "Simon Boudrias <admin@simonboudrias.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/SBoudrias/Inquirer.js.git"
  },
  "workspaces": [
    "packages/*",
    "integration/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "demo": "node --watch-path=packages/ packages/demo/src/index.ts",
    "dev": "turbo watch tsc",
    "postinstall": "git config --local include.path ../.gitconfig || true",
    "prepublishOnly": "yarn tsc",
    "prepack": "find packages/* -maxdepth 1 -type f -name 'README*' -exec sed -i.bak -e 's/utm_source=github/utm_source=npmjs/g' {} + && find packages/* -maxdepth 1 -type f -name 'README*.bak' -delete && package normalize && package pin @inquirer/type",
    "postpack": "git -c hook.auto-install.event= restore packages/*/README.md",
    "setup": "setup-packages && package lint && oxfmt . --no-error-on-unmatched-pattern",
    "pretest": "yarn tsc && oxlint . && oxfmt --check . && eslint .",
    "test": "vitest --run packages && jest && turbo test",
    "tsc": "turbo tsc && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@lerna-lite/cli": "^5.6.0",
    "@lerna-lite/publish": "^5.6.0",
    "@repo/eslint-parser": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@sboudrias/package": "workspace:*",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-oxlint": "^1.58.0",
    "fast-check": "^4.10.2",
    "globals": "^17.4.0",
    "isolate-monorepo-package": "workspace:*",
    "jest": "^30.5.2",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "setup-packages": "workspace:*",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "turbo": "^2.9.4",
    "type-fest": "^5.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "nano-staged": {
    "*": "yarn oxfmt --no-error-on-unmatched-pattern",
    "*.m?[jt]sx?": [
      "yarn oxlint --fix",
      "yarn eslint --fix"
    ]
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
