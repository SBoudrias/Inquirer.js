{
  "extends": "@repo/tsconfig",
  "compilerOptions": {
    "isolatedDeclarations": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "jest"],
    // tinybench (vitest dependency) types reference DOM lib types like
    // `DOMHighResTimeStamp`, and the shared config keeps skipLibCheck off.
    "lib": ["es2023", "dom"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
